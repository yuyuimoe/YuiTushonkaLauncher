<?xml version="1.0" encoding="utf-8" ?>
<!--
  Coverage configuration (phase 13 owns the 90 % gate; this file exists so the number is comparable
  from the start).

  Exclusions, each justified:
    - **/Migrations/**            EF Core generated migration code.
    - Domain/Catalog.cs           pure data bags: EF sets their properties by reflection, so their
    - Domain/Instances.cs         accessors are never executed by our own code.
    - Persistence/SettingsRecord.cs  the same, for the single settings row.
    - Core/Forge/ForgeModels.cs   API-shaped records: pure data, no branches worth testing.
    - Core/Forge/ForgeResults.cs  idem (the two computed properties are covered elsewhere).
    - Core/Forge/ForgeQueries.cs  idem.
    - FileSystem/FileSystemNative.cs  P/Invoke shim: it is all platform branches, exercised per OS.
    - **/*.g.cs                   source-generator output (regex, JSON, MVVM).
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[YuiTushonkaLauncher.Core]*,[YuiTushonkaLauncher.Infrastructure]*</Include>
          <ExcludeByFile>**/Migrations/**/*.cs,**/Domain/Catalog.cs,**/Domain/Instances.cs,**/Persistence/SettingsRecord.cs,**/Forge/ForgeModels.cs,**/Forge/ForgeResults.cs,**/Forge/ForgeQueries.cs,**/FileSystem/FileSystemNative.cs,**/*.g.cs</ExcludeByFile>
          <SingleHit>false</SingleHit>
          <UseSourceLink>true</UseSourceLink>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
