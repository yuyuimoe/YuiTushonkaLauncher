<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:YuiTushonkaLauncher.ViewModels"
  x:Class="YuiTushonkaLauncher.Views.ConfirmDialog"
  x:DataType="vm:ConfirmDialogViewModel"
  Width="460"
  SizeToContent="Height"
  CanResize="False"
  WindowStartupLocation="CenterOwner"
  Title="{Binding Title}"
  ShowInTaskbar="False"
>
  <StackPanel Margin="20" Spacing="14">
    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
    <CheckBox Content="{Binding CheckboxLabel}" IsChecked="{Binding CheckboxValue}" IsVisible="{Binding HasCheckbox}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="{Binding ConfirmLabel}" Command="{Binding AcceptCommand}" Classes="primary" />
      <Button Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" IsVisible="{Binding ShowsCancel}" />
    </StackPanel>
  </StackPanel>
</Window>
