<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:YuiTushonkaLauncher.ViewModels"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DesignWidth="760"
  d:DesignHeight="480"
  x:Class="YuiTushonkaLauncher.Views.ServerView"
  x:DataType="vm:ServerPageViewModel"
>
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" ColumnDefinitions="1.4*,1*" ColumnSpacing="16">
    <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Classes="sectionTitle" Text="{Binding Title}" Margin="0" />
        <TextBlock Text="{Binding StateText}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding PortText}" Classes="caption" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Classes="primary" Command="{Binding StartCommand}" Content="{Binding StartLabel}" IsEnabled="{Binding CanStart}" />
        <Button Command="{Binding StopCommand}" Content="{Binding StopLabel}" IsEnabled="{Binding CanStop}" />
        <Button Command="{Binding SyncCommand}" Content="{Binding SyncLabel}" IsEnabled="{Binding CanStop}" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="4" Margin="0,0,0,8">
      <TextBlock Text="{Binding Status}" Classes="caption" IsVisible="{Binding HasStatus}" />
      <TextBlock Text="{Binding Error}" Classes="error" IsVisible="{Binding HasError}" />
      <TextBlock Text="{Binding SyncText}" Classes="caption" IsVisible="{Binding IsRunning}" />
    </StackPanel>

    <!-- The servers the launcher keeps: the local one first, always there. -->
    <Grid Grid.Row="2" Grid.ColumnSpan="2" RowDefinitions="Auto,Auto" ColumnDefinitions="1.2*,1*" ColumnSpacing="12" Margin="0,0,0,10">
      <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
        <TextBlock Grid.Column="0" Text="{Binding ServersLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button Grid.Column="1" Command="{Binding AddServerCommand}" Content="{Binding AddServerLabel}" />
      </Grid>

      <Border Grid.Row="1" Grid.Column="0" Classes="card" Padding="6" MaxHeight="132">
        <ListBox
          Classes="dense"
          ItemsSource="{Binding Servers}"
          SelectedItem="{Binding SelectedServer}"
          Background="Transparent"
          BorderThickness="0"
        >
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ServerEntryRowViewModel">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <StackPanel Grid.Column="0" Spacing="1">
                  <TextBlock Text="{Binding Name}" FontSize="12" />
                  <TextBlock Text="{Binding Address}" Classes="caption" FontSize="10" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding DetailText}" Classes="caption" FontSize="10" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <TextBox Grid.Column="0" Text="{Binding EditName}" PlaceholderText="{Binding ServerNameLabel}" />
          <Button Grid.Column="1" Command="{Binding ActivateServerCommand}" Content="{Binding ActivateServerLabel}" />
        </Grid>
        <Grid ColumnDefinitions="*,90" ColumnSpacing="6">
          <TextBox Grid.Column="0" Text="{Binding EditHost}" PlaceholderText="{Binding ServerHostLabel}" />
          <TextBox Grid.Column="1" Text="{Binding EditPort}" PlaceholderText="{Binding ServerPortLabel}" />
        </Grid>
        <WrapPanel ItemSpacing="6" LineSpacing="6">
          <Button Classes="primary" Command="{Binding SaveServerCommand}" Content="{Binding SaveServerLabel}" />
          <Button Command="{Binding TestServerCommand}" Content="{Binding TestServerLabel}" />
          <Button
            Command="{Binding RemoveServerCommand}"
            Content="{Binding RemoveServerLabel}"
            IsEnabled="{Binding CanRemoveSelectedServer}"
          />
        </WrapPanel>
        <TextBlock Text="{Binding ServerStatusText}" Classes="caption" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>

    <!-- Output. -->
    <Grid Grid.Row="3" Grid.Column="0" RowDefinitions="Auto,*">
      <TextBlock Grid.Row="0" Text="{Binding OutputLabel}" FontWeight="SemiBold" />
      <ListBox Grid.Row="1" Classes="dense" ItemsSource="{Binding Output}" FontFamily="monospace" FontSize="11" />
    </Grid>

    <!-- Profiles. -->
    <Grid Grid.Row="3" Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto">
      <TextBlock Grid.Row="0" Text="{Binding ProfilesLabel}" FontWeight="SemiBold" />
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,6" ColumnSpacing="6">
        <TextBox Grid.Column="0" Text="{Binding NewUsername}" PlaceholderText="{Binding UsernameLabel}" />
        <ComboBox
          Grid.Column="1"
          ItemsSource="{x:Static vm:ServerPageViewModel.Editions}"
          SelectedItem="{Binding SelectedEdition}"
          MinWidth="120"
        />
      </Grid>

      <StackPanel Grid.Row="2" Spacing="4" Margin="0,8">
        <TextBlock Text="{Binding ProfilesEmptyText}" Classes="caption" IsVisible="{Binding !HasProfiles}" />
        <ListBox
          Classes="dense"
          ItemsSource="{Binding Profiles}"
          SelectedItem="{Binding SelectedProfile}"
          IsVisible="{Binding HasProfiles}"
        >
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ProfileRowViewModel">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding Nickname}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Level, StringFormat='{}{0}'}" Classes="caption" />
                <TextBlock Text="{Binding Edition}" Classes="caption" />
                <TextBlock Text="{Binding StateText}" Classes="caption" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>

      <WrapPanel Grid.Row="3">
        <Button
          Command="{Binding CreateProfileCommand}"
          Content="{Binding NewProfileLabel}"
          IsEnabled="{Binding CanCreateProfile}"
          Margin="0,0,6,6"
        />
        <Button
          Command="{Binding SelectProfileCommand}"
          CommandParameter="{Binding SelectedProfile}"
          Content="{Binding SelectLabel}"
          IsEnabled="{Binding CanActOnProfile}"
          Margin="0,0,6,6"
        />
        <Button
          Command="{Binding WipeCommand}"
          CommandParameter="{Binding SelectedProfile}"
          Content="{Binding WipeLabel}"
          IsEnabled="{Binding CanActOnProfile}"
          Margin="0,0,6,6"
        />
        <Button
          Command="{Binding DeleteProfileCommand}"
          CommandParameter="{Binding SelectedProfile}"
          Content="{Binding DeleteLabel}"
          IsEnabled="{Binding CanActOnProfile}"
        />
      </WrapPanel>
    </Grid>
  </Grid>
</UserControl>
