<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:YuiTushonkaLauncher.ViewModels"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DesignWidth="700"
  d:DesignHeight="560"
  x:Class="YuiTushonkaLauncher.Views.SettingsView"
  x:DataType="vm:SettingsPageViewModel"
  ScrollViewer.VerticalScrollBarVisibility="Auto"
>
  <StackPanel Spacing="10">
    <TextBlock Classes="sectionTitle" Text="{Binding Title}" />

    <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding LanguageLabel}" VerticalAlignment="Center" />
      <ComboBox
        Grid.Row="0"
        Grid.Column="1"
        ItemsSource="{Binding Languages}"
        SelectedItem="{Binding SelectedLanguage}"
        DisplayMemberBinding="{Binding Name}"
      />

      <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ThemeLabel}" VerticalAlignment="Center" />
      <ComboBox
        Grid.Row="1"
        Grid.Column="1"
        ItemsSource="{Binding Themes}"
        SelectedItem="{Binding SelectedTheme}"
        DisplayMemberBinding="{Binding Name}"
      />

      <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding InstancesRootLabel}" VerticalAlignment="Center" />
      <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding InstancesRoot}" />

      <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding DownloadsLabel}" VerticalAlignment="Center" />
      <NumericUpDown
        Grid.Row="3"
        Grid.Column="1"
        Value="{Binding MaxConcurrentDownloads}"
        Minimum="1"
        Maximum="16"
        Increment="1"
        FormatString="0"
      />

      <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding RetentionDaysLabel}" VerticalAlignment="Center" />
      <NumericUpDown
        Grid.Row="4"
        Grid.Column="1"
        Value="{Binding LogRetentionDays}"
        Minimum="1"
        Maximum="365"
        Increment="1"
        FormatString="0"
      />

      <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding RetentionFilesLabel}" VerticalAlignment="Center" />
      <NumericUpDown
        Grid.Row="5"
        Grid.Column="1"
        Value="{Binding LogRetentionFiles}"
        Minimum="1"
        Maximum="500"
        Increment="1"
        FormatString="0"
      />

      <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding GameStartWindowLabel}" VerticalAlignment="Center" />
      <ComboBox
        Grid.Row="6"
        Grid.Column="1"
        ItemsSource="{Binding Windows}"
        SelectedItem="{Binding SelectedWindow}"
        DisplayMemberBinding="{Binding Name}"
      />

      <TextBlock Grid.Row="7" Grid.Column="0" Text="{Binding AskBeforeStopLabel}" VerticalAlignment="Center" />
      <CheckBox Grid.Row="7" Grid.Column="1" IsChecked="{Binding AskBeforeStoppingProcesses}" />
    </Grid>

    <StackPanel Orientation="Horizontal" Spacing="10">
      <Button Classes="primary" Command="{Binding SaveCommand}" Content="{Binding SaveLabel}" />
      <TextBlock Text="{Binding Status}" Classes="caption" VerticalAlignment="Center" IsVisible="{Binding HasStatus}" />
      <TextBlock Text="{Binding Error}" Classes="error" VerticalAlignment="Center" IsVisible="{Binding HasError}" />
    </StackPanel>

    <Separator />

    <TextBlock Text="{Binding PathsLabel}" FontWeight="SemiBold" />
    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DataRootLabel}" Classes="caption" />
      <SelectableTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DataRoot}" />
      <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ConfigRootLabel}" Classes="caption" />
      <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConfigRoot}" />
      <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding LogsDirectoryLabel}" Classes="caption" />
      <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LogsDirectory}" />
      <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding InstancesDirectoryLabel}" Classes="caption" />
      <SelectableTextBlock Grid.Row="3" Grid.Column="1" Text="{Binding InstancesDirectory}" />
    </Grid>

    <Separator />

    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="{Binding AboutLabel}" FontWeight="SemiBold" />
      <SelectableTextBlock Text="{Binding VersionText}" />
    </StackPanel>
  </StackPanel>
</UserControl>
