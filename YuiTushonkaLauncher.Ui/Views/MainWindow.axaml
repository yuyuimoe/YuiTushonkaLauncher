<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:YuiTushonkaLauncher.ViewModels"
  xmlns:views="using:YuiTushonkaLauncher.Views"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DesignWidth="1000"
  d:DesignHeight="680"
  x:Class="YuiTushonkaLauncher.Views.MainWindow"
  x:DataType="vm:ShellViewModel"
  Icon="/Assets/icon.ico"
  Width="1000"
  Height="680"
  MinWidth="760"
  MinHeight="480"
  Title="{Binding Title}"
>
  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Launch panel: always visible, because launching is what the launcher is for. -->
    <Border Grid.Row="0" Padding="16,12" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button
            Classes="primary"
            Command="{Binding LaunchPanel.LaunchCommand}"
            IsEnabled="{Binding LaunchPanel.CanPressLaunch}"
            Content="{Binding LaunchPanel.LaunchLabel}"
            AutomationProperties.Name="{Binding LaunchPanel.LaunchLabel}"
          />
          <Button
            Command="{Binding LaunchPanel.StopCommand}"
            IsEnabled="{Binding LaunchPanel.CanPressStop}"
            Content="{Binding LaunchPanel.StopLabel}"
            AutomationProperties.Name="{Binding LaunchPanel.StopLabel}"
          />
          <Button
            Command="{Binding LaunchPanel.CancelLaunchCommand}"
            IsEnabled="{Binding LaunchPanel.CanPressCancel}"
            Content="{Binding LaunchPanel.CancelLabel}"
            AutomationProperties.Name="{Binding LaunchPanel.CancelLabel}"
          />
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding LaunchPanel.Message}" Classes="caption" />
          <TextBlock Text="{Binding LaunchPanel.ProblemsText}" Classes="error" IsVisible="{Binding LaunchPanel.HasProblems}" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{Binding LaunchPanel.ProfileLabel}" VerticalAlignment="Center" />
          <TextBox Text="{Binding LaunchPanel.ProfileUsername}" Width="160" PlaceholderText="{Binding LaunchPanel.ProfileLabel}" />
          <CheckBox Content="{Binding LaunchPanel.RememberLabel}" IsChecked="{Binding LaunchPanel.RememberProfile}" />
          <CheckBox Content="{Binding LaunchPanel.SkipPatchLabel}" IsChecked="{Binding LaunchPanel.SkipPatch}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="200,*">
      <!-- Left rail. -->
      <Border Grid.Column="0" Background="{DynamicResource YttRailBrush}">
        <ItemsControl ItemsSource="{Binding NavItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItemViewModel">
              <Button
                Classes="rail"
                Classes.selected="{Binding IsSelected}"
                Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).GoCommand}"
                CommandParameter="{Binding Section}"
                AutomationProperties.Name="{Binding AccessibleName}"
              >
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding Glyph}" Width="16" />
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <!-- The page. -->
      <ContentControl Grid.Column="1" Margin="16" Content="{Binding CurrentPage}" />
    </Grid>

    <Border Grid.Row="2" Classes="statusBar">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <TextBlock Grid.Column="0" Text="{Binding StatusBar.InstanceText}" />
        <TextBlock Grid.Column="1" Text="{Binding StatusBar.ServerText}" Margin="12,0" />
        <TextBlock Grid.Column="2" Text="{Binding StatusBar.PatchText}" Margin="12,0" />
        <TextBlock Grid.Column="3" Text="{Binding StatusBar.DownloadsText}" Margin="12,0" />
      </Grid>
    </Border>
  </Grid>
</Window>
